# Скопируйте этот файл в .env и заполните значения (локальный запуск).
# На Railway эти же переменные задаются во вкладке Variables сервиса.

# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:replace_with_your_token

# Telegram ID администратора: ему доступны /stats и /feedbacks, ему приходят новые отзывы.
# Узнать свой ID можно у бота @userinfobot
ADMIN_ID=280147464

# Часовой пояс (список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Europe/Moscow

# Путь к базе SQLite. Локально можно не задавать (будет tasks.db рядом с ботом).
# На Railway укажите путь внутри Volume, например /data/tasks.db — тогда данные не пропадут при перезапуске.
# DB_PATH=/data/tasks.db

# Прокси для Telegram — нужен только при локальном запуске, если api.telegram.org не открывается без VPN.
# На Railway НЕ задавать.
# PROXY_URL=socks5://127.0.0.1:1080
