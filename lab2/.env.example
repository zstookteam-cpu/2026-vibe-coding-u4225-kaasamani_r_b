# Скопируйте этот файл в .env и заполните значения

# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:replace_with_your_token

# Часовой пояс (список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# По умолчанию Europe/Moscow
TIMEZONE=Europe/Moscow

# Прокси для Telegram (необязательно). Если api.telegram.org не открывается без VPN,
# укажите адрес прокси, например socks5://127.0.0.1:1080 или http://127.0.0.1:7890
# PROXY_URL=
